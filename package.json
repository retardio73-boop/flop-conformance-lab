{
  "name": "@flop-tools/conformance-lab",
  "version": "0.1.4",
  "description": "Cross-system conformance testing for FLOP, TCLK, Technocore and routing implementations.",
  "type": "module",
  "bin": { "flop-conformance": "dist/src/cli.js" },
  "exports": { ".": "./dist/src/index.js" },
  "files": ["dist/src", "dist/conformance", "conformance", "README.md", "LICENSE", "SECURITY.md", "NOTICE", "CHANGELOG.md"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -b --clean && tsc -p tsconfig.json && node tools/copy-assets.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "conformance": "node dist/src/cli.js run --suite all",
    "pack:check": "npm pack --dry-run",
    "package:smoke": "npm run build && node tools/package-smoke.js",
    "check": "npm run typecheck && npm test && npm run conformance && npm run pack:check && npm run package:smoke"
  },
  "keywords": ["flop", "tclk", "technocore", "conformance", "interoperability"],
  "license": "Apache-2.0",
  "dependencies": { "@flop-labs/tclk": "0.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
